# ---------------------------------------------------------------------------
# claude-remote configuration
#
# Copy to .env and edit. Every value has a working default, so an empty .env
# (or none at all) runs the app on this machine only. The server validates
# what it is given on boot and refuses to start with a readable error rather
# than running half-configured.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
# There is no sign-in. Reaching the port is what grants access, so HOST must be
# somewhere only trusted devices can reach. Two supported choices:
#
#   127.0.0.1        This machine only. Reach it from a phone or a laptop with
#                    `tailscale serve --bg 4180`, which terminates TLS inside
#                    the tailnet and proxies here. Preferred: real HTTPS, and
#                    nothing new listens on any network.
#
#   100.x.y.z        This machine's Tailscale address, from `tailscale ip -4`.
#                    Reachable by tailnet devices directly, over plain HTTP.
#
# Anything else — 0.0.0.0 above all — is refused, because it would put an
# unauthenticated server on the local network.
HOST=127.0.0.1
PORT=4180
LOG_LEVEL=info

# Where the SQLite file lives, relative to the repo root.
DATABASE_PATH=./data/claude-remote.db

# --- Reaching it from other devices ----------------------------------------
# The address other devices use, no trailing slash. Optional: it only adds the
# name to the allowlist below and prints it at boot.
#
# https matters for more than eavesdropping — passkeys, service workers and web
# push all require a secure context, and none of them work over plain http.
# `tailscale serve` provides a real certificate for your MagicDNS name.
#   PUBLIC_URL=https://subhams-mac-mini.tail7b6b35.ts.net
PUBLIC_URL=

# --- Host allowlist --------------------------------------------------------
# The server answers only to request host names it recognises. This is what
# stops a page on the open web from re-resolving its own name to a local
# address and then scripting requests at this server (DNS rebinding).
#
# It checks the name in the request, never the address it came from, so it
# never limits which devices can connect: loopback, the whole Tailscale range
# (100.64.0.0/10) and any *.ts.net name are allowed automatically. A device
# added to your tailnet tomorrow needs nothing here.
#
# Add anything else, comma separated:
#   ALLOWED_HOSTS=mac-mini.local,dev.example.com
ALLOWED_HOSTS=

# --- Projects --------------------------------------------------------------
# The folders a session may be started in, as name=path pairs. Declared rather
# than discovered on purpose: a session can only ever start somewhere you named,
# and the server refuses to boot if one of these is not a directory.
#
#   PROJECTS=claude-remote=~/Projects/claude-remote,api=~/work/api-gateway
#
# Left empty, the repo root is the only project.
PROJECTS=

# What runs in a session. `claude` is the point; `bash` is useful for poking at
# the terminal bridge without spending subscription quota.
TERMINAL_COMMAND=claude

# --- Containers only -------------------------------------------------------
# Waives the bind-address rule above. Inside a container 0.0.0.0 is only the
# container's own namespace, and the port mapping decides real exposure — see
# docker-compose.yml. Setting this on the host defeats the rule entirely.
# BIND_ANY=false
