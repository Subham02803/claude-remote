# ---------------------------------------------------------------------------
# claude-remote configuration
#
# Copy to .env and edit. The server validates every value on boot and refuses
# to start with a readable error rather than running half-configured.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
# Keep HOST on loopback. The tunnel (ngrok) is what exposes the app; binding
# to 0.0.0.0 would put it on your local network as well, for no benefit.
HOST=127.0.0.1
PORT=4180
LOG_LEVEL=info

# Where the SQLite file lives, relative to the repo root.
DATABASE_PATH=./data/claude-remote.db

# --- Authentication --------------------------------------------------------
# google  Google sign-in, then a 6-digit authenticator code.
# local   A password you set, then a 6-digit authenticator code.
# none    No authentication at all. Refused unless HOST is loopback.
AUTH_MODE=none

# Signs session cookies. Required for AUTH_MODE=google and local.
# Generate one:  openssl rand -base64 48
SESSION_SECRET=

# The only address allowed to sign in. Required for AUTH_MODE=google.
ALLOWED_EMAIL=

# --- Public URL (the tunnel) -----------------------------------------------
# Your reserved ngrok domain, no trailing slash. Required for AUTH_MODE=google,
# because Google needs one exact, unchanging redirect URI.
#   PUBLIC_URL=https://your-name.ngrok-free.app
PUBLIC_URL=

# --- Google OAuth ----------------------------------------------------------
# From Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Authorised redirect URI must be exactly:
#   ${PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
