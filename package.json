{
  "name": "claude-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drive Claude Code on your own machine from any browser",
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:docker": "./scripts/dev.sh --docker",
    "dev:logs": "./scripts/dev.sh --logs",
    "dev:clean": "./scripts/dev.sh --clean",
    "dev:server": "pnpm --filter @claude-remote/server dev",
    "dev:web": "pnpm --filter @claude-remote/web dev",
    "typecheck": "pnpm -r typecheck",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.3"
  }
}
